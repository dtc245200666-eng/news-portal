{
  "name": "news-portal",
  "version": "1.0.0",
  "description": "NewsPortal - Cổng thông tin điện tử hoàn chỉnh",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "npm run prisma:migrate --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "keywords": [
    "newsportal",
    "express",
    "react",
    "typescript",
    "prisma",
    "postgresql"
