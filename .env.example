# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsportal?schema=public

# Authentication & Security
JWT_SECRET=newsportal_super_secure_jwt_secret_key_2026_dev_replace_in_prod
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=newsportal_refresh_token_secret_key_2026_dev_replace_in_prod
REFRESH_TOKEN_EXPIRES_IN=30d

# Initial Admin Credentials (used during seed)
ADMIN_INITIAL_EMAIL=admin@newsportal.vn
ADMIN_INITIAL_PASSWORD=Admin@Password123!

# SMTP Email Configuration (Optional - for real email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@newsportal.vn

# Frontend Public API URL (used by Vite frontend)
VITE_API_URL=http://localhost:5000/api/v1
