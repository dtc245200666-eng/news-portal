{
  "openapi": "3.0.0",
  "info": {
    "title": "NewsPortal API",
    "version": "1.0.0",
    "description": "Tài liệu API đầy đủ cho Cổng thông tin điện tử NewsPortal"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Đăng ký tài khoản mới",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "confirmPassword": { "type": "string" }
                },
                "required": ["fullName", "email", "password", "confirmPassword"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Đăng ký thành công" },
          "400": { "description": "Dữ liệu không hợp lệ" },
          "409": { "description": "Email đã tồn tại" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Đăng nhập hệ thống",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Đăng nhập thành công" },
          "401": { "description": "Sai thông tin đăng nhập" }
        }
      }
    },
    "/articles": {
      "get": {
        "summary": "Lấy danh sách bài viết đã xuất bản (có phân trang)",
        "tags": ["Articles"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "oldest", "popular"] } }
        ],
        "responses": {
          "200": { "description": "Danh sách bài viết" }
        }
      }
    },
    "/articles/{slug}": {
      "get": {
        "summary": "Lấy chi tiết bài viết theo slug",
        "tags": ["Articles"],
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Chi tiết bài viết" },
          "404": { "description": "Không tìm thấy bài viết" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Lấy danh sách cây danh mục tin tức",
        "tags": ["Categories"],
        "responses": {
          "200": { "description": "Cây danh mục" }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Tìm kiếm bài viết theo từ khóa",
        "tags": ["Search"],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Kết quả tìm kiếm" }
        }
      }
    },
    "/admin/dashboard": {
      "get": {
        "summary": "Lấy dữ liệu thống kê tổng quan cho quản trị viên",
        "tags": ["Admin"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dữ liệu thống kê" },
          "403": { "description": "Không có quyền truy cập" }
        }
      }
    }
  }
}
